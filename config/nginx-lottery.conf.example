server {
    listen 80 default_server;
    server_name exchange.example.com 10.0.0.10;
    server_tokens off;
    location ^~ /.well-known/acme-challenge/ { root /var/lib/letsencrypt; }
    location / { return 301 https://exchange.example.com$request_uri; }
}
limit_req_zone $binary_remote_addr zone=lottery_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=lottery_cms:10m rate=30r/s;
server {
    listen 443 ssl http2 default_server;
    server_name exchange.example.com;
    ssl_certificate /etc/letsencrypt/live/exchange.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/exchange.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    client_max_body_size 1m;
    client_body_timeout 15s;
    access_log /var/log/nginx/lottery.access.log;
    error_log /var/log/nginx/lottery.error.log;
    # Independent Go CMS; business APIs continue to use the existing Node service.
    location = /api/cms/admin/media {
        limit_req zone=lottery_cms burst=10 nodelay;
        limit_req_status 429;
        client_max_body_size 6m;
        client_body_timeout 60s;
        proxy_pass http://lottery_cms;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
    location = /api/cms/integrations/147 {
        access_log off;
        limit_req zone=lottery_cms burst=10 nodelay;
        limit_req_status 429;
        client_max_body_size 128k;
        proxy_pass http://lottery_cms;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
    }
    location ^~ /api/cms/ {
        limit_req zone=lottery_cms burst=60 nodelay;
        limit_req_status 429;
        proxy_pass http://lottery_cms;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
        client_max_body_size 256k;
    }
    # Published CMS articles are server-rendered for readers and search crawlers.
    location ^~ /article/ {
        limit_req zone=lottery_cms burst=60 nodelay;
        limit_req_status 429;
        proxy_pass http://lottery_cms/api/cms/public/article/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
    }
    location = /sitemap.xml {
        limit_req zone=lottery_cms burst=60 nodelay;
        limit_req_status 429;
        proxy_pass http://lottery_cms/api/cms/public/sitemap.xml;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
    }
    location ~ ^/api/(login|register|admin/(login|ops/mfa/(verify|recover)))$ {
        limit_req zone=lottery_auth burst=10 nodelay;
        limit_req_status 429;
        include /etc/nginx/snippets/lottery-proxy.conf;
    }
    location / { include /etc/nginx/snippets/lottery-proxy.conf; }
}
server {
    listen 80;
    server_name wishjp.cc;
    server_tokens off;
    return 410;
}
server {
    listen 443 ssl;
    server_name wishjp.cc;
    ssl_certificate /etc/letsencrypt/live/wishjp.cc/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wishjp.cc/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    return 410;
}
